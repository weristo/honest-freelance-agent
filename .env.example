# Copy to .env and fill in YOUR OWN keys. Never commit .env.

# PayPal developer SANDBOX app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only the sandbox host is accepted; anything else raises LiveHostRefused.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox personas (developer.paypal.com -> Sandbox accounts), used by `demo --invoice`
HFA_SANDBOX_MERCHANT_EMAIL=
HFA_SANDBOX_BUYER_EMAIL=

# LLM proposer: anthropic (default) | openai_compat. The mock is only the --mock switch.
HFA_LLM_PROVIDER=anthropic
HFA_MODEL=claude-haiku-4-5
# The LLM key is read ONLY from this file (or the file named by HFA_ENV_FILE),
# never from your shell environment.
ANTHROPIC_API_KEY=
# only for openai_compat
HFA_OPENAI_COMPAT_KEY=
HFA_OPENAI_BASE_URL=

# Optional: lower the built-in caps (USD 1/day, USD 15 total). Cannot raise them.
HFA_BUDGET_DAILY_USD=
HFA_BUDGET_TOTAL_USD=
